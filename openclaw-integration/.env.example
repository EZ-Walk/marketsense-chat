# MarketSense Open Claw Integration Configuration

# Service Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:18789

# Open Claw Gateway Configuration
OPENCLAW_GATEWAY_URL=http://openclaw:18789
OPENCLAW_GATEWAY_TOKEN=marketsense-gateway-token

# AI Provider API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MarketSense Database Configuration
NEO4J_URI=bolt://marketsense-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=marketsense123

# Redis Configuration
REDIS_URL=redis://openclaw-redis:6379

# Messaging Platform Integration (Optional)
DISCORD_TOKEN=your_discord_bot_token_here
SLACK_TOKEN=your_slack_bot_token_here
TELEGRAM_TOKEN=your_telegram_bot_token_here

# MarketSense Service URLs
MARKETSENSE_CHAT_URL=http://marketsense-chat:3000
MARKETSENSE_WEB_URL=http://marketsense-web:3000
MARKETSENSE_EVENT_STREAM_URL=http://marketsense-event-stream:8080

# Logging Configuration
LOG_LEVEL=info